###############################################################################
# MAGENTO 2 ENTERPRISE DEVOPS - LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# 
# ARCHITECTURE NOTE:
# This file serves as a template for local development. Copy to `.env` to run.
#
# STORAGE RULES:
# - Local Dev: `.env` (gitignored, never committed)
# - Kubernetes: Kubernetes Secrets (manifests or SealedSecrets / External Secrets)
# - Production: AWS Secrets Manager (injected via IRSA / EKS Pod Identity)
# - phpMyAdmin: DO NOT STORE CREDENTIALS IN PHPMYADMIN TABLES! phpMyAdmin is strictly
#               a database management tool, NOT a secrets vault.
###############################################################################

# --- Application Core ---
APP_NAME=magento2-devops
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# --- Web & Admin Ports ---
WEB_PORT=8080
PHPMYADMIN_PORT=8081
RABBITMQ_MANAGEMENT_PORT=15672

# ==============================================================================
# MONITORING SUITE CREDENTIALS & PORTS (PROMETHEUS & GRAFANA)
# ==============================================================================
# Prometheus Server Metrics Scraping Port
PROMETHEUS_PORT=9090

# Grafana Visual Analytics Dashboard (Port 3001 avoids conflict with main dev port 3000)
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GrafanaAdminSecurePass123!
GF_SECURITY_ADMIN_PASSWORD=GrafanaAdminSecurePass123!

# ==============================================================================
# ALL STORE CREDENTIALS & MULTI-STORE ARCHITECTURE
# NOTE: Stored in .env (local) or AWS Secrets Manager (production).
# NEVER store credentials in custom phpMyAdmin database tables!
# ==============================================================================

# --- Store 1: Main Retail Storefront ---
STORE_MAIN_CODE=default
STORE_MAIN_NAME="Default Main Store"
STORE_MAIN_URL=http://localhost:8080
STORE_MAIN_ADMIN_FIRSTNAME=DevOps
STORE_MAIN_ADMIN_LASTNAME=Admin
STORE_MAIN_ADMIN_EMAIL=admin@example.com
STORE_MAIN_ADMIN_USERNAME=devopsadmin
STORE_MAIN_ADMIN_PASSWORD=AdminPassword123!
STORE_MAIN_BACKEND_FRONTNAME=admin_control
STORE_MAIN_API_TOKEN=m2_main_retail_api_token_secret_xyz789

# --- Store 2: B2B Wholesale Storefront ---
STORE_B2B_CODE=b2b_store
STORE_B2B_NAME="B2B Wholesale Store"
STORE_B2B_URL=http://b2b.localhost:8080
STORE_B2B_DATABASE=magento2_b2b
STORE_B2B_ADMIN_USERNAME=b2badmin
STORE_B2B_ADMIN_PASSWORD=B2BAdminSecurePass123!
STORE_B2B_API_TOKEN=m2_b2b_wholesale_api_token_secret_uvw456

# --- Store 3: European International Storefront (Multi-Currency / Locale) ---
STORE_EU_CODE=eu_store
STORE_EU_NAME="European Union Store"
STORE_EU_URL=http://eu.localhost:8080
STORE_EU_DATABASE=magento2_eu
STORE_EU_CURRENCY=EUR
STORE_EU_LANGUAGE=fr_FR
STORE_EU_ADMIN_USERNAME=euadmin
STORE_EU_ADMIN_PASSWORD=EUAdminSecurePass123!
STORE_EU_API_TOKEN=m2_eu_store_api_token_secret_abc123

# --- MySQL Database Configuration ---
# Container service name 'mysql' used inside Docker network. NEVER use 'localhost' between containers.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=magento2
MYSQL_USER=magento
MYSQL_PASSWORD=magento_local_dev_pass123!
MYSQL_ROOT_PASSWORD=root_local_dev_pass123!

# --- Redis Cache & Session Configuration ---
# Container service name 'redis' used inside Docker network.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- OpenSearch Catalog Search Configuration ---
# Container service name 'opensearch' used inside Docker network.
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX_PREFIX=magento2_local

# --- RabbitMQ Message Broker Configuration ---
# Container service name 'rabbitmq' used inside Docker network.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# --- Magento Installation Defaults ---
MAGENTO_ADMIN_FIRSTNAME=DevOps
MAGENTO_ADMIN_LASTNAME=Admin
MAGENTO_ADMIN_EMAIL=admin@example.com
MAGENTO_ADMIN_USERNAME=devopsadmin
MAGENTO_ADMIN_PASSWORD=AdminPassword123!
MAGENTO_BACKEND_FRONTNAME=admin_control

# Locale & Regional
MAGENTO_LANGUAGE=en_US
MAGENTO_CURRENCY=USD
MAGENTO_TIMEZONE=UTC
MAGENTO_USE_REWRITES=1

# Adobe Commerce / Composer Authentication (Obtained from repo.magento.com)
COMPOSER_MAGENTO_USERNAME=your_public_auth_key
COMPOSER_MAGENTO_PASSWORD=your_private_auth_key
