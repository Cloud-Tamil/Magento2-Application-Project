{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Magento 2 Web Storefront & Edge Performance",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "title": "HTTP Request Throughput (Req/sec)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(nginx_http_requests_total[1m])) by (status)",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "title": "502 / 504 Error Rate (Critical)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(nginx_http_requests_total{status=~\"502|504\"}[1m]))",
          "legendFormat": "502/504 Bad Gateway",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "title": "PHP-FPM Active vs Idle Workers",
      "type": "timeseries",
      "targets": [
        {
          "expr": "php_fpm_active_processes",
          "legendFormat": "Active Workers",
          "refId": "A"
        },
        {
          "expr": "php_fpm_idle_processes",
          "legendFormat": "Idle Workers",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 101,
      "title": "Database, Cache & Search Primitives",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "qps"
        }
      },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 9 },
      "id": 4,
      "title": "MySQL 8.0 Query Throughput",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(mysql_global_status_questions[1m])",
          "legendFormat": "Queries/sec",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "green", "value": 90 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 9 },
      "id": 5,
      "title": "Redis Cache Hit Ratio",
      "type": "gauge",
      "targets": [
        {
          "expr": "(rate(redis_keyspace_hits_total[1m]) / (rate(redis_keyspace_hits_total[1m]) + rate(redis_keyspace_misses_total[1m]))) * 100",
          "legendFormat": "Hit Ratio %",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 9 },
      "id": 6,
      "title": "OpenSearch Query Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(opensearch_indices_search_query_time_ms[1m])",
          "legendFormat": "Query Latency (ms)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 9 },
      "id": 7,
      "title": "RabbitMQ Queue Message Depth",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rabbitmq_queue_messages_ready) by (queue)",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["magento2", "devops", "ecommerce"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "Magento 2 Enterprise Production Overview",
  "uid": "magento2-prod-overview",
  "version": 1
}
